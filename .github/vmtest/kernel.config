# Copyright (c) Meta Platforms, Inc. and affiliates.

CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_LSM=y
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_NETWORK=y
CONFIG_LSM="bpf"

# LSM programs use tracing helpers and BPF trampolines.
CONFIG_PERF_EVENTS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y

# CO-RE and vmlinux.h require BTF.
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y

# The tests verify fs-verity signatures against keyrings.
CONFIG_FS_VERITY=y
CONFIG_KEYS=y
CONFIG_SYSTEM_DATA_VERIFICATION=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_CRYPTO_SHA256=y

# The harness uses ext4 on a loop device and tmpfs.
CONFIG_EXT4_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y

# BPF programs need btrfs types in vmlinux.h.
CONFIG_BTRFS_FS=y

# Tests use mount and PID namespaces.
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y

CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_UNIX=y
CONFIG_MODULES=y
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
